+fn embedder_about(app: &mut DesignApp, ui: &mut egui::Ui, t: &Tokens) {
+    let brand = crate::brand::get();
+    ui.vertical_centered(|ui| {
+        ui.add_space(8.0);
+        ui.label(crate::rtl::widget(ui, egui::RichText::new(brand.name).font(semibold(26.0)).color(t.text_strong)));
+        crate::rtl::label(
+            ui,
+            egui::RichText::new(format!(
+                "{} {} · DesignCraft {}",
+                crate::i18n::tr(&app.ui.language, "Version"),
+                brand.version,
+                env!("CARGO_PKG_VERSION")
+            ))
+            .size(12.0)
+            .color(t.text_dim),
+        );
+        ui.add_space(4.0);
+        ui.label(crate::rtl::widget(ui, egui::RichText::new(brand.tagline).size(13.0).color(t.text)));
+        if let Some(credit) = brand.credit {
+            ui.label(crate::rtl::widget(ui, egui::RichText::new(credit).size(12.0).color(t.text_dim)));
+        }
+        if !brand.links.is_empty() {
+            ui.add_space(14.0);
+            ui.horizontal_wrapped(|ui| {
+                for (text, url) in brand.links {
+                    if link(ui, text, url, t.accent) {
+                        app.ui.pending_urls.push(url.to_string());
+                    }
+                    ui.add_space(6.0);
+                }
+            });
+        }
+        ui.add_space(12.0);
+        ui.label(crate::rtl::widget(
+            ui,
+            egui::RichText::new(crate::i18n::tr(&app.ui.language, "Open source. No telemetry.")).size(11.0).color(t.text_dim),
+        ));
+        ui.add_space(8.0);
+        if ui.button(crate::rtl::widget(ui, crate::i18n::tr(&app.ui.language, "  Close  "))).clicked() {
+            app.ui.about = false;
+        }
+    });
+}
