diff --git a/crates/ui-egui/src/brand.rs b/crates/ui-egui/src/brand.rs
new file mode 100644
index 00000000..df440c49
--- /dev/null
+++ b/crates/ui-egui/src/brand.rs
@@ -0,0 +1,76 @@
+//! The app's name and its project and community surfaces: DesignCraft's by default. An app built on
+//! DesignCraft sets its own with [`set`] before the UI starts.
+//!
+//! The ArtCraft mark and name may only identify DesignCraft itself (`docs/brand/LICENSE-brand.txt`), so
+//! with [`Brand::artcraft`] off the UI leaves out the mark, the ArtCraft community (Discord, website,
+//! the other ArtCraft apps) and DesignCraft's project links, and shows the app's own name, credit line and
+//! links instead.
+
+/// What the UI calls the app, and which project and community surfaces it shows.
+#[derive(Clone, Copy, Debug)]
+pub struct Brand {
+    /// The app's name: title bar, start screen, About.
+    pub name: &'static str,
+    /// The app's version, for About (DesignCraft's own version is shown beside it for another brand).
+    pub version: &'static str,
+    /// One line under the name on the start screen and in About.
+    pub tagline: &'static str,
+    /// Show the ArtCraft mark, community and sibling apps and DesignCraft's project links. Only
+    /// DesignCraft itself may.
+    pub artcraft: bool,
+    /// A plain-text credit line for About when `artcraft` is off (for example "Based on DesignCraft by
+    /// the ArtCraft team").
+    pub credit: Option<&'static str>,
+    /// The app's own links for About when `artcraft` is off: (label, URL).
+    pub links: &'static [(&'static str, &'static str)],
+}
+
+/// DesignCraft's own brand.
+pub const DESIGNCRAFT: Brand = Brand {
+    name: "DesignCraft",
+    version: env!("CARGO_PKG_VERSION"),
+    tagline: "Page layout for print and screen — fast, open and scriptable.",
+    artcraft: true,
+    credit: None,
+    links: &[],
+};
+
+/// The commands that open ArtCraft or DesignCraft project pages; hidden when `artcraft` is off.
+pub const ARTCRAFT_COMMANDS: &[&str] = &["help.discord", "help.appPage", "help.website", "help.app", "help.github", "help.issues"];
+
+static BRAND: std::sync::OnceLock<Brand> = std::sync::OnceLock::new();
+
+/// Sets the app's brand, once, before the UI starts. Returns false if it was already set.
+pub fn set(brand: Brand) -> bool {
+    BRAND.set(brand).is_ok()
+}
+
+/// The app's brand: what [`set`] gave, else [`DESIGNCRAFT`].
+pub fn get() -> &'static Brand {
+    BRAND.get().unwrap_or(&DESIGNCRAFT)
+}
+
+/// Whether the menus show command `id` under the current brand.
+pub fn shows(id: &str) -> bool {
+    shows_under(get(), id)
+}
+
+fn shows_under(brand: &Brand, id: &str) -> bool {
+    brand.artcraft || !ARTCRAFT_COMMANDS.contains(&id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn designcraft_shows_its_community_and_another_brand_does_not() {
+        assert!(get().artcraft, "DesignCraft's brand is the default");
+        let other = Brand { name: "Other", artcraft: false, ..DESIGNCRAFT };
+        for id in ARTCRAFT_COMMANDS {
+            assert!(shows_under(&DESIGNCRAFT, id));
+            assert!(!shows_under(&other, id), "{id}");
+        }
+        assert!(shows_under(&other, "help.about") && shows_under(&other, "file.newSample"));
+    }
+}
