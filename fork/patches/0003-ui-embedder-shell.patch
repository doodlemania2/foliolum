diff --git a/crates/ui-egui/src/shell.rs b/crates/ui-egui/src/shell.rs
new file mode 100644
index 00000000..50e49f21
--- /dev/null
+++ b/crates/ui-egui/src/shell.rs
@@ -0,0 +1,74 @@
+//! Room in the window for an app built on DesignCraft: its own bar under the app bar, its own strip
+//! at the left edge, its own controls in the app bar, and which of DesignCraft's bars to show. The
+//! app sets it with [`set`] before the UI starts; by default nothing changes.
+//!
+//! The hooks are plain functions called while [`crate::DesignApp::ui`] lays out the window, so what
+//! they draw takes its place among DesignCraft's panels. They can run any command (`app.run`), select
+//! tools and draw DesignCraft's own panels and icons, as a menu or the toolbar would.
+
+use crate::DesignApp;
+
+/// Draws part of the window. `ui` is the root `Ui` at that point of the layout: add a panel to it.
+pub type Hook = fn(&mut DesignApp, &mut egui::Ui);
+
+/// Which of DesignCraft's bars to show, decided each frame.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Chrome {
+    /// The menus in the app bar.
+    pub menu_bar: bool,
+    /// The workspace menu in the app bar.
+    pub workspace_menu: bool,
+    /// The Tools panel at the left.
+    pub toolbar: bool,
+    /// The Control bar under the app bar.
+    pub control_bar: bool,
+}
+
+impl Chrome {
+    /// Everything DesignCraft shows.
+    pub const ALL: Chrome = Chrome { menu_bar: true, workspace_menu: true, toolbar: true, control_bar: true };
+}
+
+/// What an embedding app adds to the window, and which of DesignCraft's bars it keeps.
+#[derive(Clone, Copy, Debug)]
+pub struct Shell {
+    /// Which of DesignCraft's bars to show; asked each frame, so the app can switch modes.
+    pub chrome: fn(&DesignApp) -> Chrome,
+    /// Drawn right under the app bar (and above the Control bar), as a top panel.
+    pub top: Option<Hook>,
+    /// Drawn at the left edge, left of the Tools panel, as a left panel.
+    pub left: Option<Hook>,
+    /// Drawn in the app bar after the menus (or where they would be), inline.
+    pub app_bar: Option<Hook>,
+}
+
+/// DesignCraft's own window: nothing added, every bar shown.
+pub const DESIGNCRAFT: Shell = Shell { chrome: |_| Chrome::ALL, top: None, left: None, app_bar: None };
+
+static SHELL: std::sync::OnceLock<Shell> = std::sync::OnceLock::new();
+
+/// Sets the app's shell, once, before the UI starts. Returns false if it was already set.
+pub fn set(shell: Shell) -> bool {
+    SHELL.set(shell).is_ok()
+}
+
+/// The app's shell: what [`set`] gave, else [`DESIGNCRAFT`].
+pub fn get() -> &'static Shell {
+    SHELL.get().unwrap_or(&DESIGNCRAFT)
+}
+
+/// The bars to show this frame.
+pub fn chrome(app: &DesignApp) -> Chrome {
+    (get().chrome)(app)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn designcraft_keeps_its_whole_window() {
+        assert!(get().top.is_none() && get().left.is_none() && get().app_bar.is_none());
+        assert_eq!((DESIGNCRAFT.chrome)(&DesignApp::new(designcraft_engine::Session::new(), Default::default())), Chrome::ALL);
+    }
+}
