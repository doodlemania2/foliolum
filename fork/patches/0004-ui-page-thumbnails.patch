+/// The thumbnail of document page `abs` (absolute index), `h` points high, from the Pages panel's
+/// cache, for an embedder that lists the pages its own way. It is refreshed as the panel's are.
+pub fn page_thumbnail(app: &mut DesignApp, ctx: &egui::Context, abs: usize, h: f32) -> Option<egui::TextureHandle> {
+    thumb(app, ctx, ThumbOf::Page(abs), h)
+}
