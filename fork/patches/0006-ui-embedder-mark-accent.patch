+/// Paint the app's own mark ([`crate::brand::Brand::mark`]) into `rect` (square), rasterised once per
+/// size and cached. Draws nothing when the brand has none.
+pub fn paint_brand_mark(ui: &egui::Ui, rect: Rect) {
+    use designcraft_render::vello_cpu::{self, kurbo, peniko};
+    let brand = crate::brand::get();
+    if brand.mark.is_empty() || brand.mark_view <= 0.0 {
+        return;
+    }
+    let ctx = ui.ctx();
+    let ppp = ctx.pixels_per_point();
+    let px = ((rect.width().min(rect.height()) * ppp).round() as u32).clamp(8, 1024);
+    let key = egui::Id::new(("brand_mark", px));
+    let tex: Option<egui::TextureHandle> = ctx.data(|d| d.get_temp(key));
+    let tex = tex.unwrap_or_else(|| {
+        let mut rc = vello_cpu::RenderContext::new_with(px as u16, px as u16, vello_cpu::RenderSettings { num_threads: 0, ..Default::default() });
+        rc.set_transform(kurbo::Affine::scale(px as f64 / brand.mark_view));
+        let color = |c: u32| peniko::Color::from_rgba8((c >> 16) as u8, (c >> 8) as u8, c as u8, 255);
+        for shape in brand.mark {
+            let Ok(p) = kurbo::BezPath::from_svg(shape.path) else { continue };
+            if let Some(fill) = shape.fill {
+                rc.set_paint(color(fill));
+                rc.fill_path(&p);
+            }
+            if let Some((stroke, width)) = shape.stroke {
+                rc.set_paint(color(stroke));
+                rc.set_stroke(kurbo::Stroke::new(width).with_join(kurbo::Join::Round).with_caps(kurbo::Cap::Round));
+                rc.stroke_path(&p);
+            }
+        }
+        rc.flush();
+        let mut pm = vello_cpu::Pixmap::new(px as u16, px as u16);
+        let mut res = vello_cpu::Resources::new();
+        rc.render(&mut pm, &mut res);
+        let ci = egui::ColorImage::from_rgba_premultiplied([px as usize, px as usize], pm.data_as_u8_slice());
+        let t = crate::widgets::load_texture(ctx, "brand_mark", ci, egui::TextureOptions::LINEAR);
+        ctx.data_mut(|d| d.insert_temp(key, t.clone()));
+        t
+    });
+    let side = rect.width().min(rect.height());
+    let r = Rect::from_center_size(rect.center(), vec2(side, side));
+    ui.painter().image(tex.id(), r, Rect::from_min_max(pos2(0.0, 0.0), pos2(1.0, 1.0)), Color32::WHITE);
+}
